# ==============================================================================
# GMAIL SMTP CONFIGURATION (Portfolio Contact Form)
# ==============================================================================
# SMTP Server Settings (Pre-configured for Gmail SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Your full Gmail address used for authenticating with Gmail SMTP
SMTP_USER=your_gmail_address@gmail.com

# 16-character Google App Password (NOT your normal Gmail password).
# How to generate:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Visit: https://myaccount.google.com/apppasswords
# 3. Enter an app name (e.g., "Portfolio Contact Form") and click Create.
# 4. Copy the generated 16-letter password and paste it here without spaces.
SMTP_PASS=your_gmail_app_password

# The destination email address where client project inquiries should be delivered
CONTACT_TO_EMAIL=your_gmail_address@gmail.com

# The sender email address shown on outgoing notification emails
CONTACT_FROM_EMAIL=your_gmail_address@gmail.com

# ==============================================================================
# OPTIONAL DEPLOYMENT CONFIGURATION
# ==============================================================================
# The canonical URL where this portfolio is hosted
APP_URL=http://localhost:4000
